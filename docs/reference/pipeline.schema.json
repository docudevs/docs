{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.docudevs.ai/reference/pipeline.schema.json",
  "title": "DocuDevs Pipeline",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "nodes", "finals"],
  "properties": {
    "version": {
      "const": "2026-05"
    },
    "description": {
      "type": "string"
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "finals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/final"
      }
    },
    "concurrency": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxNodes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["inline", "queue"]
        }
      }
    },
    "ocr": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "mode": {
          "type": "string",
          "description": "One of default, premium, excel, none, auto, low. Matched case-insensitively by the API (OcrType.fromValue). sourceLocations, extractFigures, and describeFigures require default, premium, or auto."
        },
        "sourceLocations": {
          "type": "boolean"
        },
        "extractFigures": {
          "type": "boolean"
        },
        "describeFigures": {
          "type": "boolean"
        }
      }
    },
    "resources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/resource"
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/input"
      }
    }
  },
  "$defs": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["literal", "nodeArtifact", "clientArtifact"]
        },
        "nodeId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "pointer": {
          "type": "string",
          "description": "RFC 6901 JSON Pointer selecting a nested value from the resolved artifact. Maximum depth 32."
        },
        "value": {
          "description": "Literal value; only meaningful when kind is literal."
        }
      }
    },
    "nodeType": {
      "type": "string",
      "enum": ["extract", "validate", "transform", "OCR_CORRECT", "operation", "final"]
    },
    "resource": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": true,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string"
        }
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "type": {
          "type": "string"
        },
        "resource": {
          "type": "string"
        },
        "config": {
          "type": "object"
        }
      }
    },
    "condition": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1,
      "additionalProperties": false,
      "properties": {
        "eq": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2
        },
        "ne": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2
        },
        "exists": {
          "type": "string"
        },
        "and": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/condition"
          }
        },
        "or": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/condition"
          }
        },
        "not": {
          "$ref": "#/$defs/condition"
        }
      }
    },
    "node": {
      "type": "object",
      "required": ["id", "type"],
      "additionalProperties": true,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "$ref": "#/$defs/nodeType"
        },
        "dependsOn": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "when": {
          "$ref": "#/$defs/condition"
        },
        "onError": {
          "type": "string",
          "enum": ["fail", "continue"]
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "source": {
          "type": "string"
        },
        "prompt": {
          "type": "string"
        },
        "schema": {
          "type": ["object", "string"]
        },
        "llm": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "tier": {
              "type": "string"
            }
          }
        },
        "tools": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/tool"
          }
        },
        "resource": {
          "type": "string"
        },
        "sourceLocations": {
          "type": "boolean"
        },
        "sourceLocationGranularity": {
          "type": "string"
        },
        "imageIndices": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "calculatedFields": {
          "type": "boolean"
        },
        "input": {
          "type": ["object", "array", "string", "number", "boolean", "null"]
        },
        "operation": {
          "type": "string"
        },
        "transform": {
          "type": "string"
        },
        "validator": {
          "type": "string",
          "enum": ["bucket"]
        },
        "config": {
          "type": "object"
        },
        "mode": {
          "type": "string"
        },
        "output": {
          "type": ["object", "array", "string", "number", "boolean", "null"]
        }
      }
    },
    "final": {
      "type": "object",
      "required": ["node"],
      "additionalProperties": false,
      "properties": {
        "node": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
