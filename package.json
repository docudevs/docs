{
  "name": "docudevs-ai",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "sync-openapi-spec": "node tools/examples/sync-spec.mjs",
    "start": "npm run examples:manifest && docusaurus start",
    "build": "npm run examples:manifest && docusaurus build",
    "swizzle": "docusaurus swizzle",
    "deploy": "npm run examples:manifest && docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "gen-api-docs": "docusaurus gen-api-docs all",
    "clean-api-docs": "docusaurus clean-api-docs all",
    "typecheck": "tsc",
    "examples:manifest": "node tools/examples/build-manifest.mjs",
    "examples:coverage": "node tools/examples/check-coverage.mjs",
    "examples:inline": "node tools/examples/check-inline-code.mjs",
    "examples:curl": "node tools/examples/check-curl.mjs",
    "sdk:index": "tools/examples/python/.venv/bin/python -B tools/examples/python/gen_sdk_index.py docs/reference/sdk-method-index.md",
    "examples:test": "node --test tools/examples/test/*.test.mjs",
    "api-docs": "docusaurus clean-api-docs all && docusaurus gen-api-docs all"
  },
  "dependencies": {
    "@docusaurus/core": "3.8.1",
    "@docusaurus/preset-classic": "3.8.1",
    "@easyops-cn/docusaurus-search-local": "^0.55.0",
    "@mdx-js/react": "^3.0.0",
    "@reduxjs/toolkit": "^2.6.0",
    "clsx": "^2.0.0",
    "docusaurus-plugin-openapi-docs": "4.5.1",
    "docusaurus-theme-openapi-docs": "4.5.1",
    "prism-react-renderer": "^2.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-redux": "^9.2.0"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.7.0",
    "@docusaurus/tsconfig": "3.7.0",
    "@docusaurus/types": "3.7.0",
    "js-yaml": "^4.1.0",
    "typescript": "~5.6.2"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=20"
  }
}
